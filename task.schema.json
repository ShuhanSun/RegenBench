{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenbench.dev/task.schema.json",
  "title": "RegenBench Task",
  "type": "object",
  "required": [
    "id",
    "test_command",
    "regenerate_command",
    "canonical_sources",
    "generated_artifacts"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "test_command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "regenerate_command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "canonical_sources": {
      "type": "array",
      "items": {"type": "string"}
    },
    "generated_artifacts": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
